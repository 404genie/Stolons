# Mainnet clients are opt-in. Keep transactions disabled through release review.
MAINNET_RPC_URL=
# Required server-only durable public Blob store credential. Never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
# Keeper values must match the approved manifest after deployment.
KEEPER_CLUSTER=mainnet-beta
KEEPER_RPC_URL=
KEEPER_PROGRAM_ID=
KEEPER_LOOKUP_TABLE=
KEEPER_KEYPAIR_PATH=/run/secrets/keeper-keypair.json
# Indexer (optional for current UI; recommended for complete volume/history).
SOLANA_RPC_URL=
STOLONS_PROGRAM_ID=
DATABASE_URL=
POLL_INTERVAL_MS=15000

# Public frontend settings: generate these from the validated deployment manifest.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_STOLONS_PROGRAM_ID=
NEXT_PUBLIC_LAUNCH_LOOKUP_TABLE=
NEXT_PUBLIC_GRADUATION_TARGET_LAMPORTS=
NEXT_PUBLIC_ENABLE_MAINNET_TRANSACTIONS=false

# Fee keeper: dry-run uses only the payer public key; apply uses its separate secret.
KEEPER_WALLET=
# Optional comma-separated allowlist; empty discovers registered tokens on-chain.
FEE_KEEPER_MINTS=
