# Preparation only. Mainnet transaction clients remain disabled in this release.
MAINNET_RPC_URL=
# Required server-only durable public Blob store credential. Never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
# Keeper values must match the approved manifest after deployment.
KEEPER_CLUSTER=mainnet-beta
KEEPER_RPC_URL=
KEEPER_PROGRAM_ID=
KEEPER_LOOKUP_TABLE=
KEEPER_KEYPAIR_PATH=/run/secrets/keeper-keypair.json
# Indexer (optional for current UI; recommended for complete volume/history).
SOLANA_RPC_URL=
STOLONS_PROGRAM_ID=
DATABASE_URL=
POLL_INTERVAL_MS=15000
