FROM node:22-bookworm-slim
WORKDIR /app
RUN npm install -g pnpm@11.25.0
COPY . .
ENV NEXT_PUBLIC_SOLANA_CLUSTER=devnet
ENV NEXT_PUBLIC_ENABLE_MAINNET_TRANSACTIONS=false
RUN pnpm install --frozen-lockfile && pnpm sdk:build && pnpm web:build
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@stolons/web", "start", "--hostname", "0.0.0.0", "--port", "3000"]
